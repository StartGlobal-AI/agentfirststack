{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic template: local dev, tests and the defaults for every deployment. Real deployments
  // don't edit this file; `pnpm afs config <profile>` derives wrangler.deploy.json from it plus
  // deploy/<profile>.json (account, domain, resource ids, vars). See docs/self-hosting.md.
  "name": "afs-analytics",
  "main": "src/index.ts",
  // Must stay <= the workerd bundled with @cloudflare/vitest-pool-workers (1.20260815).
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The browser tracker (src/tracker/*.ts) is bundled + minified by esbuild into dist/tracker.txt,
  // which the Worker imports as a Text module and serves at /s.js.
  "build": { "command": "node scripts/build-tracker.mjs", "watch_dir": "src" },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afs-analytics",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    // Shared identity (accounts + API keys): bind the same database in every app so one key works
    // everywhere. Running only this app? Delete this binding; keys then live in DB.
    {
      "binding": "AUTH_DB",
      "database_name": "afs-identity",
      // A different placeholder from DB's, so local dev and tests keep two databases, as deployed.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../site/migrations"
    }
  ],

  // Burst limit on /v1/signup per IP; same namespace as the other apps, so it's one shared counter.
  // The rest are this app's fair-use limits (namespaces 42001-42009; counted per Cloudflare location).
  // Each binding is optional in code: remove one and that limit is off.
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    // POST /e per client network (an IPv4 address or IPv6 prefix; the visitor's IP behind a proxy with the proxy key)
    { "name": "INGEST_IP_LIMITER", "namespace_id": "42001", "simple": { "limit": 120, "period": 60 } },
    // POST /e per site
    { "name": "INGEST_SITE_LIMITER", "namespace_id": "42002", "simple": { "limit": 3000, "period": 60 } },
    // POST /v1/sites/:id/events and /payments (and their MCP tools) per account; each call carries up to 100
    { "name": "API_INGEST_LIMITER", "namespace_id": "42003", "simple": { "limit": 120, "period": 60 } },
    // SQL queries per account
    { "name": "SQL_LIMITER", "namespace_id": "42004", "simple": { "limit": 30, "period": 60 } },
    // verify per account, and per verified domain across accounts (each is an outbound fetch)
    { "name": "VERIFY_LIMITER", "namespace_id": "42005", "simple": { "limit": 6, "period": 60 } },
    // Stripe webhook deliveries per site id
    { "name": "WEBHOOK_LIMITER", "namespace_id": "42006", "simple": { "limit": 300, "period": 60 } },
    // public share dashboard requests per share token
    { "name": "SHARE_LIMITER", "namespace_id": "42007", "simple": { "limit": 120, "period": 60 } }
  ],

  // One SQLite-backed Durable Object per site: its events, sessions, settings copy and queries.
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "SiteDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteDO"] }],

  "vars": {
    // The URL agents and install snippets use. Empty = the request origin.
    "PUBLIC_BASE_URL": "",
    // Prefix of the API keys this app mints ("afs" everywhere, so shared keys look alike).
    "KEY_PREFIX": "afs",
    // open | token | closed (see @afs/shared auth)
    "SIGNUP_MODE": "open",
    // "true" only in local dev (.dev.vars): enables x-dev-geo-* headers and an insecure fallback salt.
    "DEV_MODE": ""
  },
  // Optional vars a deployment can add: SIGNUP_HOURLY_LIMIT, MAX_SITES_PER_ACCOUNT, SIGNUP_TOKEN,
  // SQL_MAX_ROWS_READ (rows a /sql query may read after its first row; default 1000000),
  // MAX_ANNOTATIONS_PER_SITE, MAX_FUNNELS_PER_SITE (unset = no cap), MAX_GOALS_PER_SITE (default 100),
  // MAX_SHARE_LINKS_PER_SITE (default 10), MAX_EVENTS_PER_SITE_PER_DAY, MAX_EVENTS_PER_ACCOUNT_PER_DAY,
  // DAILY_EVENT_BUDGET, MAX_SITE_STORAGE_MB, MIN_RETENTION_DAYS, MAX_RETENTION_DAYS (unset = off),
  // SQL_TIME_BUDGET_MS (default 60000 per 10 minutes). Each also has an UNCLAIMED_<NAME> form for
  // accounts no person has claimed (see README "Config").
  // Secrets (wrangler secret put): SALT_SECRET (required), SIGNUP_TOKEN, ADMIN_TOKEN,
  // ENCRYPTION_KEY (optional: seals the Stripe webhook signing secret; openssl rand -base64 32).

  "observability": { "enabled": true }
}
