# Copy to .dev.vars for `pnpm dev`. Never commit .dev.vars.
# Derives the daily visitor salt: daily_salt = HMAC(SALT_SECRET, YYYY-MM-DD). Generate: openssl rand -hex 32
SALT_SECRET=change-me-to-a-long-random-string
# Local dev only: honours x-dev-geo-* headers (fake request.cf geo) and allows verify to fetch localhost.
DEV_MODE=true
# Optional: rows a /sql query may read after its first result row before it is stopped (default 1000000)
# SQL_MAX_ROWS_READ=1000000
# Optional: a Google API key for lab runs (GET /v1/sites/:id/web-vitals/lab, PageSpeed Insights).
# Unset = keyless, on Google's small shared quota.
# PAGESPEED_API_KEY=
# Optional: seals the Stripe webhook signing secret and alert destinations' webhook / Slack URLs
# (32 bytes, base64): openssl rand -base64 32. Without it connecting Stripe or adding a webhook /
# Slack destination returns 503 not_configured.
# ENCRYPTION_KEY=
# Optional: sender of alert and report emails (with the EMAIL send_email binding; an address on a
# domain onboarded for Cloudflare Email Sending). Unset = email destinations are refused.
# ALERT_EMAIL_FROM=alerts@example.com
# Optional fair-use caps (unset = no cap). Each also reads UNCLAIMED_<NAME> for accounts nobody has claimed.
# MAX_SITES_PER_ACCOUNT=
# MAX_ANNOTATIONS_PER_SITE=
# MAX_COST_ROWS_PER_SITE=
# MAX_ITEMS_PER_EVENT=
# MAX_USER_PROP_KEYS_PER_SITE=
# MAX_CRAWL_HITS_PER_SITE_PER_DAY=
# MAX_CRAWL_HITS_PER_ACCOUNT_PER_DAY=
# MAX_CRAWL_HITS_PER_DAY=
# MAX_BROWSER_USER_PROP_KEYS_PER_SITE=
# MAX_IMPORTED_ROWS_PER_SITE=
# MAX_IMPORTS_PER_SITE=
# MAX_EXPORT_ROWS_PER_SITE_PER_DAY=
# MAX_FUNNELS_PER_SITE=
# MAX_GOALS_PER_SITE=100
# MAX_SHARE_LINKS_PER_SITE=10
# MAX_SEGMENTS_PER_SITE=50
# MAX_ALERTS_PER_SITE=20
# MAX_ALERT_DESTINATIONS_PER_SITE=5
# MAX_REPORTS_PER_SITE=5
# MAX_ALERT_DELIVERIES_PER_SITE_PER_DAY=100
# MAX_ALERT_EMAILS_PER_SITE_PER_DAY=10
# Daily (UTC) event caps per site / per account, and for the whole deployment (unset = off)
# MAX_EVENTS_PER_SITE_PER_DAY=
# MAX_EVENTS_PER_ACCOUNT_PER_DAY=
# DAILY_EVENT_BUDGET=
# Stop storing a site's events past this database size (unset = off)
# MAX_SITE_STORAGE_MB=
# Bounds for retention_days (unset = 1..3650)
# MIN_RETENTION_DAYS=
# MAX_RETENTION_DAYS=
# SQL wall time a site may use per 10 minutes, ms (default 60000; 0 = off)
# SQL_TIME_BUDGET_MS=60000
# Optional: the replay app's URL. Sites with replay_site_id then load its recorder from the tracker
# (run replay's `pnpm dev` too). Unset = off.
# REPLAY_BASE_URL=http://localhost:8790
# Optional: open | token | closed
# SIGNUP_MODE=open
# SIGNUP_TOKEN=
# ADMIN_TOKEN=
# Optional: same value as the site's; lets the site's dashboard read this app as a project (x-afs-internal).
# INTERNAL_TOKEN=
