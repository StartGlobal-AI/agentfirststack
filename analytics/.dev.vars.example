# Copy to .dev.vars for `pnpm dev`. Never commit .dev.vars.
# Derives the daily visitor salt: daily_salt = HMAC(SALT_SECRET, YYYY-MM-DD). Generate: openssl rand -hex 32
SALT_SECRET=change-me-to-a-long-random-string
# Local dev only: honours x-dev-geo-* headers (fake request.cf geo) and allows verify to fetch localhost.
DEV_MODE=true
# Optional: rows a /sql query may read after its first result row before it is stopped (default 1000000)
# SQL_MAX_ROWS_READ=1000000
# Optional: seals the Stripe webhook signing secret (32 bytes, base64): openssl rand -base64 32.
# Without it POST /v1/sites/:id/integrations/stripe returns 503 not_configured.
# ENCRYPTION_KEY=
# Optional fair-use caps (unset = no cap)
# MAX_ANNOTATIONS_PER_SITE=
# MAX_FUNNELS_PER_SITE=
# Optional: open | token | closed
# SIGNUP_MODE=open
# SIGNUP_TOKEN=
# ADMIN_TOKEN=
# Optional: same value as the site's; lets the site's dashboard read this app as a project (x-afs-internal).
# INTERNAL_TOKEN=
