{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Generic template: local dev, tests and the defaults for every deployment. Real deployments
  // don't edit this file; `pnpm afs config <profile>` derives wrangler.deploy.json from it plus
  // deploy/<profile>.json (account, domain, resource ids, vars). See docs/self-hosting.md.
  "name": "afs-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  "vars": {
    // Shared domain every account can create inboxes on. Needs Email Routing (catch-all -> this
    // Worker) and Email Sending onboarding on the operator's Cloudflare account. See README.
    "MAIL_DOMAIN": "mail.example.com",
    // Per-account cap on recipients sent to per UTC day (protects domain reputation).
    "SEND_DAILY_LIMIT": "200",
    // Must equal "name" above: auto_configure points a zone's catch-all rule at this Worker.
    "WORKER_NAME": "afs-mail",
    // open | token | closed (see @afs/shared auth). Set SIGNUP_TOKEN / ADMIN_TOKEN as secrets.
    "SIGNUP_MODE": "open",
    // Public URL of this Worker, used in responses and llms.txt. Empty = request origin.
    "PUBLIC_BASE_URL": "",
    // Prefix of the API keys this app mints ("afs" everywhere, so shared keys look alike).
    "KEY_PREFIX": "afs",
    // "true" only for local development (.dev.vars): lets webhooks use http://localhost.
    "DEV_MODE": "false"
  },
  // Optional vars a deployment can add (public services want them; see src/env.ts and README Config):
  // SIGNUP_HOURLY_LIMIT, SHARED_SEND_POLICY, SHARED_RETENTION_DAYS, MAX_INBOXES_PER_ACCOUNT,
  // MAX_INBOX_CREATES_PER_DAY, MAX_INBOX_DELETES_PER_DAY, ADDRESS_TOMBSTONE_DAYS (default 90),
  // EXTRA_RESERVED_USERNAMES, MAX_MESSAGES_PER_INBOX, MAX_INBOUND_PER_ACCOUNT_PER_DAY,
  // MAX_INBOUND_PER_SENDER_PER_DAY, MAX_TEXT_BYTES_PER_ACCOUNT, MAX_BLOB_BYTES_PER_ACCOUNT (default
  // 1 GiB, 256 MiB unclaimed; "0" = off), MAX_CONCURRENT_WAITS (default 3),
  // MAX_CONCURRENT_WAITS_PER_INBOX (default 2), MAX_WEBHOOKS_PER_ACCOUNT (default 10),
  // MAX_WEBHOOK_TESTS_PER_DAY, and UNCLAIMED_<name> of each per-account cap. Secrets:
  // ENCRYPTION_KEY (also keys custom-domain ownership challenges), ADMIN_TOKEN (also the
  // x-admin-token for auto_configure), SIGNUP_TOKEN, CF_API_TOKEN.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afs-mail",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    // Shared identity (accounts + API keys): bind the same database in every app so one key works
    // everywhere. Running only this app? Delete this binding; keys then live in DB.
    {
      "binding": "AUTH_DB",
      "database_name": "afs-identity",
      // A different placeholder from DB's, so local dev and tests keep two databases, as deployed.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../site/migrations"
    }
  ],

  // Approximate per-location burst limits, keyed per account (the D1 caps are the strict ones).
  // Each limiter has its own namespace (42021-42029 are reserved for mail).
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    // GET /inboxes/:id/wait, /latest-code and the MCP wait tools.
    { "name": "WAIT_LIMITER", "namespace_id": "42021", "simple": { "limit": 30, "period": 60 } },
    // POST /webhooks/:id/test (each test is an outbound request).
    { "name": "WEBHOOK_TEST_LIMITER", "namespace_id": "42022", "simple": { "limit": 5, "period": 60 } },
    // Search (GET /search, /inboxes/:id/messages?q=, the MCP search tools).
    { "name": "SEARCH_LIMITER", "namespace_id": "42023", "simple": { "limit": 30, "period": 60 } }
  ],

  // Raw .eml files, HTML bodies and attachments.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "afs-mail-blobs" }],

  // One InboxDO per inbox: parks wait_for_email callers (hibernatable WebSockets, so a waiting
  // inbox is not billed for duration) until the email() handler notifies it.
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "InboxDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxDO"] }],

  // Webhook deliveries: signed, retried with backoff.
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "afs-mail-webhooks" }],
    "consumers": [
      {
        "queue": "afs-mail-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "dead_letter_queue": "afs-mail-webhooks-dlq"
      }
    ]
  },

  // Cloudflare Email Service (Email Sending). No restriction attributes: the from-domain must be
  // onboarded for sending; the app itself enforces which addresses an account may send from.
  "send_email": [{ "name": "EMAIL" }],

  // Receiving: Email Routing must send every address on MAIL_DOMAIN to this Worker. Either set the
  // zone's catch-all to "Send to a Worker: afs-mail" in the dashboard, or let `wrangler deploy` manage
  // it by uncommenting this (catch-alls must name the zone apex, e.g. "*@agentmail.example"):
  // "addresses": ["*@your-mail-domain.example"],

  // Hourly: delete inboxes whose ttl_days has passed, shared-domain mail older than
  // SHARED_RETENTION_DAYS (with their stored blobs), webhook delivery logs older than 7 days, old
  // counters, wait slots and tombstones, and sweep R2 for blobs whose message is gone.
  "triggers": { "crons": ["17 * * * *"] }
}
