# Local secrets for `pnpm dev` (copy to .dev.vars, git-ignored). All optional here.
ADMIN_TOKEN=
SIGNUP_TOKEN=
# Local dev only: enables the fake sign-in at /auth/dev-login?email=you@example.com.
DEV_MODE=true
# Optional: real "Sign in with Google" (redirect URI http://localhost:8786/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: shared with the services' .dev.vars so the dashboard can list a project's resources.
INTERNAL_TOKEN=
# Optional: first-party domains on Cloudflare for SaaS (POST /v1/first-party-domains). A token with
# Zone > SSL and Certificates Edit and Zone > Workers Routes Edit on the SaaS zone; all four or none.
CF_SAAS_API_TOKEN=
CF_SAAS_ZONE_ID=
CF_SAAS_FALLBACK_HOST=
CF_SAAS_WORKER=
# Optional: reputation checks in the operator's daily summary (src/reputation.ts): a Google Safe
# Browsing API key, and a Spamhaus Data Query Service key (public resolvers are refused without one).
SAFE_BROWSING_API_KEY=
SPAMHAUS_DQS_KEY=
