{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic template: local dev, tests and the defaults for every deployment. Real deployments
  // don't edit this file; `pnpm afs config <profile>` derives wrangler.deploy.json from it plus
  // deploy/<profile>.json (account, domain, resource ids, vars). See docs/self-hosting.md.
  "name": "afs-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Regenerates public/.well-known/agent-skills/index.json (sha256 digests) before dev/deploy.
  "build": { "command": "node scripts/build-discovery.mjs", "watch_dir": "public/.well-known/agent-skills" },

  // Static landing page, llms.txt, guides, privacy/terms and /.well-known/* from public/, served by
  // the Worker; plus its own routes: "/" (markdown negotiation + Link headers), the MCP gateway, the
  // API, the pages for people (sign-in, claim links, dashboard) and the OAuth authorization server.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The Worker runs first for every page, not just its own routes, so it can report AI crawler
    // and search bot visits to the deployment's own analytics (src/own-analytics.ts trackCrawl).
    // It then serves the page from public/ with the rules of public/_headers (src/static-pages.ts).
    // Images, fonts, CSS and JS skip it, named one by one: a pattern like "!/*.js" also matches
    // nested paths, and then the first-party paths (/_a/s.js, /_t/c/<id>.js, /_r/rec/<hash>.js,
    // here and on customers' first-party domains) never reach the Worker and answer 404.
    // A new top-level asset goes in this list (test/static-pages.test.ts checks it).
    "run_worker_first": [
      "/*",
      "!/fonts/*",
      "!/brand/*",
      "!/og/*",
      "!/logos/*",
      "!/img/*",
      "!/app.js",
      "!/content.js",
      "!/dashboard.js",
      "!/dashboard-app.js",
      "!/styles.css",
      "!/content.css",
      "!/dashboard.css",
      "!/dashboard-app.css",
      "!/home.css",
      "!/favicon.svg",
      "!/google-g.svg"
    ]
  },

  // The MCP gateway forwards tool calls to each service's own MCP server.
  "services": [
    { "binding": "ANALYTICS", "service": "afs-analytics" },
    { "binding": "TAGS", "service": "afs-tags" },
    { "binding": "MAIL", "service": "afs-mail" },
    { "binding": "REPLAY", "service": "afs-replay" }
  ],

  // The shared identity database: every app binds it as AUTH_DB, so one key works everywhere.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afs-identity",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Daily (03:17): delete expired OAuth tokens and codes, sessions, claim links and old emails from
  // the identity DB, write setup notices, and erase deleted projects whose 7 days have passed.
  // Hourly (:47): send queued and retried emails, and the reminders before a project is erased.
  "triggers": { "crons": ["17 3 * * *", "47 * * * *"] },

  // Optional: Cloudflare Email Service, for the emails the platform sends people (src/email.ts):
  // claims, members, connected apps, project deletion, suspension, setup updates. Needs the
  // NOTIFY_EMAIL_FROM var too (an address on a domain onboarded for Email Sending); without
  // either, nothing is sent.
  "send_email": [{ "name": "EMAIL" }],

  // Burst limits (the binding only supports 10s/60s windows): signup (and OAuth client registration)
  // per network, shared by every app (namespace from the deploy profile); API key creation per
  // account (POST /v1/keys here and the dashboard; the KEYS_HOURLY_LIMIT var covers every app);
  // the setup check per account (each one reads the services about 15 times) and the setup test
  // run (it sends a test email and test events, and fetches the homepage).
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    // API-key and OAuth reads (GET/HEAD) and MCP requests per account (@afs/shared readAllowed)
    { "name": "READ_LIMITER", "namespace_id": "42044", "simple": { "limit": 300, "period": 60 } },
    // the dashboard's data route (/dashboard/projects/:id/data/...) per signed-in person
    { "name": "DASHBOARD_LIMITER", "namespace_id": "42045", "simple": { "limit": 600, "period": 60 } },
    { "name": "KEY_LIMITER", "namespace_id": "42041", "simple": { "limit": 10, "period": 60 } },
    { "name": "SETUP_LIMITER", "namespace_id": "42042", "simple": { "limit": 30, "period": 60 } },
    { "name": "SETUP_TEST_LIMITER", "namespace_id": "42043", "simple": { "limit": 3, "period": 60 } }
  ],

  "vars": {
    // The URL used in responses. Empty = the request origin.
    "PUBLIC_BASE_URL": "",
    "SIGNUP_MODE": "open",
    // Must match the apps: the per-IP signup count in signup_log is keyed with it.
    "KEY_PREFIX": "afs",
    // "true" only in local dev and tests: enables the fake sign-in at /auth/dev-login.
    "DEV_MODE": ""
  },
  // Optional vars a deployment can add (off when unset unless a default is named):
  //   signup (counted in signup_log, shared by every app): SIGNUP_HOURLY_LIMIT and SIGNUP_DAILY_LIMIT
  //   per network (IPv4 address or IPv6 /48), SIGNUP_ASN_DAILY_LIMIT per network operator,
  //   SIGNUP_GLOBAL_HOURLY_LIMIT for the whole deployment (a circuit breaker);
  //   keys: MAX_KEYS_PER_ACCOUNT (active keys, default 50), UNCLAIMED_MAX_KEYS_PER_ACCOUNT,
  //   KEYS_HOURLY_LIMIT (new keys per account per hour);
  //   AUTH_ISSUER (the OAuth issuer; default PUBLIC_BASE_URL), OAUTH_REGISTER_HOURLY_LIMIT (new OAuth
  //   clients per network per hour, default 30);
  //   own analytics: OWN_ANALYTICS_ACCOUNT_ID + OWN_ANALYTICS_SITE_ID (the deployment's own project and
  //   analytics site) get a server event for each signup and project claim here (src/own-analytics.ts);
  //   email: NOTIFY_EMAIL_FROM ("Name <address>", with the EMAIL binding), NOTIFY_REPLY_TO (optional),
  //   MAX_EMAILS_PER_PERSON_PER_DAY (default 20), OPERATOR_EMAIL (the operator's daily summary,
  //   comma-separated; src/operator-digest.ts);
  //   first-party domains on Cloudflare for SaaS (src/first-party-domains.ts): CF_SAAS_ZONE_ID (the
  //   SaaS zone), CF_SAAS_FALLBACK_HOST (the originless fallback customers CNAME to, fp.<domain>),
  //   CF_SAAS_WORKER (this Worker's name; `pnpm afs config` derives both), with the secret
  //   CF_SAAS_API_TOKEN; off (503 not_configured) unless all four are set;
  //   MAX_FIRST_PARTY_DOMAINS_PER_ACCOUNT (+ UNCLAIMED_);
  //   abuse handling (docs/operations.md, "Abuse"): SIGNUP_POW_DIFFICULTY (the proof of work past
  //   SIGNUP_GLOBAL_HOURLY_LIMIT, default 20 bits), PAUSE_LIFT_GRACE_HOURS (default 24; src/pauses.ts),
  //   ABUSE_REPORTS_HOURLY_LIMIT (per network, default 5), ABUSE_REPORTS_DAILY_LIMIT (deployment, 500),
  //   ABUSE_REPORT_EMAILS_PER_DAY (phishing/malware emailed to OPERATOR_EMAIL at once, 20)
  //   (src/abuse-reports.ts), REPUTATION_DOMAINS (extra domains for the summary's reputation checks).
  // Secrets: ADMIN_TOKEN, SIGNUP_TOKEN, INTERNAL_TOKEN (shared with the services, for the dashboard
  // and the first-party edge), GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (Sign in with Google),
  // CF_SAAS_API_TOKEN (Zone SSL and Certificates Edit + Workers Routes Edit), SAFE_BROWSING_API_KEY and
  // SPAMHAUS_DQS_KEY (reputation checks, src/reputation.ts; optional). See docs/accounts.md and
  // docs/self-hosting.md.
  "observability": { "enabled": true }
}
