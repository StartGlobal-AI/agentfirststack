{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic template: local dev, tests and the defaults for every deployment. Real deployments
  // don't edit this file; `pnpm afs config <profile>` derives wrangler.deploy.json from it plus
  // deploy/<profile>.json (account, domain, resource ids, vars). See docs/self-hosting.md.
  "name": "afs-tags",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],

  // The browser runtime (src/runtime, TypeScript + DOM) is bundled and minified by esbuild into
  // dist/runtime.txt (and dist/runtime-ext.txt with the optional features), which the Worker
  // imports as Text modules (see `rules`).
  "build": {
    "command": "node scripts/build-runtime.mjs",
    "watch_dir": ["src/runtime", "src/lib", "src/config"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],

  "observability": { "enabled": true },

  "vars": {
    // The URL agents and snippets use. Empty = the request origin.
    "PUBLIC_BASE_URL": "",
    // open | token | closed (see @afs/shared auth)
    "SIGNUP_MODE": "open",
    // Default base URL of the analytics app for `analytics` tags and destinations.
    "ANALYTICS_BASE_URL": "",
    // "true" only in local dev: allows http://localhost webhook destinations.
    "DEV_MODE": "false",
    // Prefix of the API keys this app mints ("afs" everywhere, so shared keys look alike).
    "KEY_PREFIX": "afs"
  },
  // Optional vars a deployment can add (set them in deploy/<profile>.json, not here). Each cap also
  // reads UNCLAIMED_<NAME> for accounts no person has claimed; "0" turns a cap off:
  //   SIGNUP_HOURLY_LIMIT, MAX_CONTAINERS_PER_ACCOUNT,
  //   MAX_DESTINATIONS_PER_CONTAINER (default 10), MAX_VERSIONS_PER_CONTAINER (default 50),
  //   MAX_DRAFT_BYTES (default 524288), MAX_TAGS_BYTES_PER_ACCOUNT (default 20971520),
  //   MAX_CUSTOM_CODE_BYTES, ALLOW_CUSTOM_CODE / UNCLAIMED_ALLOW_CUSTOM_CODE (default true / false),
  //   MAX_DELIVERIES_PER_CONTAINER_PER_DAY, MAX_DELIVERIES_PER_ACCOUNT_PER_DAY, MAX_DELIVERIES_PER_DAY,
  //   MAX_EVENTS_PER_CONTAINER_PER_DAY, MAX_EVENTS_PER_ACCOUNT_PER_DAY, MAX_EVENTS_PER_DAY,
  //   MAX_VISITORS_PER_CONTAINER (default 250000),
  //   MAX_CONTAINER_DB_BYTES (default 1073741824), CIRCUIT_BREAKER_FAILURES (default 20),
  //   CIRCUIT_BREAKER_MINUTES (default 60), MAX_ENVIRONMENTS_PER_CONTAINER (default 5),
  //   MAX_LOOKUPS_PER_CONTAINER (default 10), MAX_LOOKUP_ROWS (default 10000),
  //   MAX_LOOKUP_BYTES (default 1048576), MAX_EVENTS_PER_NETWORK_PER_CONTAINER_PER_DAY,
  //   MAX_QUARANTINED_EVENTS_PER_CONTAINER_PER_DAY (attack protection; unset = off), SPIKE_MIN_NETWORKS
  //   (default 20), MAX_SCANS_PER_ACCOUNT_PER_DAY, MAX_SCANS_PER_DAY, MAX_DESTINATION_TESTS_PER_ACCOUNT_PER_DAY,
  //   MAX_DESTINATION_TESTS_PER_DAY (outbound-call budgets; unset = off), EXTRA_BLOCKED_CODE_HOSTS,
  //   MAX_CONSENT_RECORDS_PER_CONTAINER_PER_DAY (consent banner records; unset = off). See README.md "Config".
  // Secrets: ENCRYPTION_KEY (required), ADMIN_TOKEN, SIGNUP_TOKEN, INTERNAL_TOKEN (shared by the
  // deployment's Workers: the site's dashboard and the ANALYTICS binding use it).

  // SIGNUP_LIMITER is shared by every app (the deploy tool sets its namespace); the others are this
  // app's own (namespaces 42011-42019) and are counted per Cloudflare location. Keys: client network
  // (IPv4 or IPv6 /48), container id or account id.
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    // API-key and OAuth reads (GET/HEAD) and MCP requests per account (@afs/shared readAllowed)
    { "name": "READ_LIMITER", "namespace_id": "42018", "simple": { "limit": 300, "period": 60 } },
    // /collect: every hit per client network, and per container.
    { "name": "COLLECT_IP_LIMITER", "namespace_id": "42011", "simple": { "limit": 600, "period": 60 } },
    { "name": "COLLECT_CONTAINER_LIMITER", "namespace_id": "42012", "simple": { "limit": 6000, "period": 60 } },
    // /collect conversions (they fan out to every destination): per client network, and per container.
    { "name": "CONVERSION_IP_LIMITER", "namespace_id": "42013", "simple": { "limit": 60, "period": 60 } },
    { "name": "CONVERSION_CONTAINER_LIMITER", "namespace_id": "42014", "simple": { "limit": 1200, "period": 60 } },
    // Per account: scan + verify (outbound fetches), destination tests, server event requests.
    { "name": "SCAN_LIMITER", "namespace_id": "42015", "simple": { "limit": 5, "period": 60 } },
    { "name": "TEST_LIMITER", "namespace_id": "42016", "simple": { "limit": 10, "period": 60 } },
    { "name": "SERVER_EVENTS_LIMITER", "namespace_id": "42017", "simple": { "limit": 120, "period": 60 } }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afs-tags",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    // Shared identity (accounts + API keys): bind the same database in every app so one key works
    // everywhere. Running only this app? Delete this binding; keys then live in DB.
    {
      "binding": "AUTH_DB",
      "database_name": "afs-identity",
      // A different placeholder from DB's, so local dev and tests keep two databases, as deployed.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../site/migrations"
    }
  ],

  // Optional, internal auth with INTERNAL_TOKEN (unbound or no INTERNAL_TOKEN = off): ANALYTICS is
  // this deployment's analytics Worker. Analytics destinations without an api_key (setup with just
  // platforms.analytics.site_id) deliver over it as the container's account; analytics refuses a
  // site of another account. `pnpm afs config` maps afs-analytics to the profile's own Worker.
  // SITE is this deployment's site Worker: a strong abuse signal pauses a capability through its
  // internal route, which emails the project's people and the operator (unbound: the pause is
  // written to AUTH_DB directly and the site's cron sends the emails).
  "services": [{ "binding": "ANALYTICS", "service": "afs-analytics" }, { "binding": "SITE", "service": "afs-site" }],

  // One ContainerDO (SQLite) per container: visitors, event log, dedupe, live config copy.
  "durable_objects": {
    "bindings": [{ "name": "CONTAINER", "class_name": "ContainerDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContainerDO"] }],

  // Server-side delivery to destinations, with retries.
  "queues": {
    "producers": [{ "binding": "DISPATCH", "queue": "afs-tags-dispatch" }],
    "consumers": [
      {
        "queue": "afs-tags-dispatch",
        "max_batch_size": 25,
        "max_batch_timeout": 2,
        "max_retries": 6,
        "retry_delay": 30,
        "dead_letter_queue": "afs-tags-dispatch-dlq"
      }
    ]
  }
}
