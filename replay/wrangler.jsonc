{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic template: local dev, tests and the defaults for every deployment. Real deployments
  // don't edit this file; `pnpm afs config <profile>` derives wrangler.deploy.json from it plus
  // deploy/<profile>.json (account, domain, resource ids, vars). See docs/self-hosting.md.
  "name": "afs-replay",
  "main": "src/index.ts",
  // Must stay <= the workerd bundled with @cloudflare/vitest-plugin (1.20261103).
  "compatibility_date": "2026-08-01",

  // The browser loader, recorder and player (src/recorder, src/player) are bundled + minified by
  // esbuild into dist/*.txt, which the Worker imports as Text modules and serves.
  "build": { "command": "node scripts/build-recorder.mjs", "watch_dir": "src" },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afs-replay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    // Shared identity (accounts + API keys): bind the same database in every app so one key works
    // everywhere. Running only this app? Delete this binding; keys then live in DB.
    {
      "binding": "AUTH_DB",
      "database_name": "afs-identity",
      // A different placeholder from DB's, so local dev and tests keep two databases, as deployed.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../site/migrations"
    }
  ],

  // Burst limit on /v1/signup per IP; same namespace as the other apps, so it's one shared counter.
  // The INGEST_* limiters guard the public browser routes (site ids are public in every customer's
  // HTML): per client network (IPv4 or IPv6 /48; loader + ingest, checked before any D1 read), per
  // site + network, and per site. Their own namespaces (42031-42039 are replay's), kept as is by
  // `pnpm afs config`. Limits are per Cloudflare location and approximate.
  "ratelimits": [
    { "name": "SIGNUP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    // API-key and OAuth reads (GET/HEAD) and MCP requests per account (@afs/shared readAllowed)
    { "name": "READ_LIMITER", "namespace_id": "42034", "simple": { "limit": 300, "period": 60 } },
    { "name": "INGEST_IP_LIMITER", "namespace_id": "42031", "simple": { "limit": 600, "period": 60 } },
    { "name": "INGEST_SITE_IP_LIMITER", "namespace_id": "42032", "simple": { "limit": 120, "period": 60 } },
    { "name": "INGEST_SITE_LIMITER", "namespace_id": "42033", "simple": { "limit": 3000, "period": 60 } }
  ],

  // Recording chunks as received (gzip JSON of rrweb events): <site_id>/<session_id>/<seq>.
  "r2_buckets": [{ "binding": "CHUNKS", "bucket_name": "afs-replay-chunks" }],

  // One SQLite-backed Durable Object per replay site: the session index, the derived event log,
  // signals, error groups and heatmap rollups. Ingest derives in the Worker, the DO only stores.
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "ReplaySiteDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReplaySiteDO"] }],

  // Optional, internal auth with INTERNAL_TOKEN (unbound or no INTERNAL_TOKEN = off): ANALYTICS gets
  // frustration signals and JS errors of a linked analytics site as events and serves its funnels;
  // TAGS gets the chosen signals and survey scores of a linked tags container as server events.
  // Optional: Cloudflare Browser Rendering (Quick Actions, billed by browser time) renders heatmap
  // images from a recorded snapshot (GET /v1/sites/:id/heatmap/image, verified sites, strict daily
  // caps). Unbound = that route answers 503 heatmap_images_unavailable.
  "browser": { "binding": "BROWSER" },

  "services": [{ "binding": "ANALYTICS", "service": "afs-analytics" }, { "binding": "TAGS", "service": "afs-tags" }],

  "vars": {
    // The URL agents and install snippets use. Empty = the request origin.
    "PUBLIC_BASE_URL": "",
    // Prefix of the API keys this app mints ("afs" everywhere, so shared keys look alike).
    "KEY_PREFIX": "afs",
    // open | token | closed (see @afs/shared auth)
    "SIGNUP_MODE": "open",
    // "true" only in local dev (.dev.vars): x-dev-geo-country, localhost origins and verify.
    "DEV_MODE": ""
  },
  // Optional: USER_CONTENT_BASE_URL, the origin of a domain of its own for the share player
  // (<it>/r/<token>; `pnpm afs config` derives it and the Worker route from the profile's
  // user_content_domain). Unset = the player stays at /play/<token> on this host.
  // Optional fair-use vars a deployment can add (README "Config" lists them with their defaults;
  // count caps also take an UNCLAIMED_<NAME> variant): SIGNUP_HOURLY_LIMIT, MAX_SITES_PER_ACCOUNT,
  // MAX_UNVERIFIED_SITES_PER_ACCOUNT, MAX_SAMPLE_RATE, MAX_SESSION_MINUTES, MAX_SESSIONS_PER_SITE_PER_DAY,
  // MAX_UNVERIFIED_SESSIONS_PER_SITE_PER_DAY, MAX_FORCED_SESSIONS_PER_SITE_PER_DAY,
  // MAX_SESSIONS_PER_IP_PER_SITE_PER_DAY, MAX_FORWARDED_EVENTS_PER_SITE_PER_DAY, MAX_TAGS_EVENTS_PER_SITE_PER_DAY,
  // MAX_HEATMAP_IMAGES_PER_SITE_PER_DAY, MAX_HEATMAP_IMAGES_PER_ACCOUNT_PER_DAY, MAX_PLATFORM_HEATMAP_IMAGES_PER_DAY, MAX_CHUNK_BYTES,
  // MAX_SESSION_BYTES, MAX_CHUNKS_PER_SESSION, MAX_DERIVED_PER_CHUNK, MAX_DERIVED_PER_SESSION,
  // MAX_{SESSIONS,CHUNKS,BYTES,DERIVED}_PER_ACCOUNT_PER_DAY, MAX_PLATFORM_{SESSIONS,CHUNKS,BYTES,DERIVED}_PER_DAY,
  // MAX_RETENTION_DAYS, MAX_HEATMAP_RETENTION_DAYS, MAX_LINKS_PER_SITE, MAX_LINK_BYTES_PER_DAY,
  // MAX_VERIFY_PER_ACCOUNT_PER_HOUR, CAPTURE_CONSOLE_ERRORS_DEFAULT, CAPTURE_NETWORK_ERRORS_DEFAULT,
  // MAX_UPGRADED_SESSIONS_PER_SITE_PER_DAY, MAX_SEGMENTS_PER_SITE, MAX_EVENT_DEFINITIONS_PER_SITE,
  // MAX_STARRED_SESSIONS_PER_SITE, MAX_STARRED_RETENTION_DAYS, MAX_STARRED_BYTES_PER_SITE, MAX_NOTES_PER_SESSION, MAX_NOTES_PER_SITE,
  // MAX_LABELS_PER_SITE, MAX_SURVEYS_PER_SITE, MAX_ACTIVE_SURVEYS_PER_SITE, MAX_QUESTIONS_PER_SURVEY,
  // MAX_ANSWER_CHARS, MAX_RESPONSES_PER_SITE_PER_DAY, MAX_RESPONSES_PER_NETWORK_PER_SITE_PER_DAY,
  // MAX_TEST_RESPONSES_PER_SITE_PER_DAY, MAX_IMPRESSIONS_PER_NETWORK_PER_SITE_PER_DAY,
  // MAX_WEBHOOKS_PER_ACCOUNT, MAX_WEBHOOK_DELIVERIES_PER_ACCOUNT_PER_DAY, MAX_WEBHOOK_TESTS_PER_DAY,
  // MAX_EXPORT_ROWS, MAX_EXPORT_BYTES_PER_DAY.
  // Secrets (wrangler secret put): SIGNUP_TOKEN, ADMIN_TOKEN, INTERNAL_TOKEN, ENCRYPTION_KEY (seals webhook secrets).

  // Hourly: R2 cleanup of deleted sites, a daily kick of each site's DO (retention, signal spikes and
  // webhook retries run on the DO's own alarm), expired share links, old usage rows and webhook logs.
  "triggers": { "crons": ["23 * * * *"] },

  "observability": { "enabled": true }
}
