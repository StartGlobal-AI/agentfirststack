# Copy to .dev.vars for `pnpm dev`. Never commit .dev.vars.
# Local dev only: honours x-dev-geo-country/-region/-city headers, accepts chunks from localhost
# origins and lets verify fetch localhost pages.
DEV_MODE=true
# Optional: open | token | closed
# SIGNUP_MODE=open
# SIGNUP_TOKEN=
# ADMIN_TOKEN=
# Optional: same value as the site's and analytics'; lets the site's dashboard read this app as a
# project (x-afs-internal), and turns on signal forwarding to a linked analytics site through the
# ANALYTICS service binding (run analytics' `pnpm dev` too for that locally).
# INTERNAL_TOKEN=
# Optional: seals webhook secrets (32 bytes, base64: openssl rand -base64 32). Without it and with
# DEV_MODE=true, webhook secrets are stored plain (local development only).
# ENCRYPTION_KEY=
# Optional: new sites start with failed-request capture on.
# CAPTURE_NETWORK_ERRORS_DEFAULT=true
# Optional fair-use controls (README "Config" has every one and its default; count caps also take
# an UNCLAIMED_<NAME> variant for accounts no person has claimed):
# MAX_SITES_PER_ACCOUNT=
# MAX_UNVERIFIED_SITES_PER_ACCOUNT=
# MAX_SAMPLE_RATE=
# MAX_SESSION_MINUTES=
# MAX_SESSIONS_PER_SITE_PER_DAY=
# MAX_UNVERIFIED_SESSIONS_PER_SITE_PER_DAY=
# MAX_FORCED_SESSIONS_PER_SITE_PER_DAY=
# MAX_SESSIONS_PER_IP_PER_SITE_PER_DAY=
# MAX_FORWARDED_EVENTS_PER_SITE_PER_DAY=
# MAX_CHUNK_BYTES=
# MAX_SESSION_BYTES=
# MAX_CHUNKS_PER_SESSION=
# MAX_DERIVED_PER_CHUNK=
# MAX_DERIVED_PER_SESSION=
# MAX_SESSIONS_PER_ACCOUNT_PER_DAY=
# MAX_CHUNKS_PER_ACCOUNT_PER_DAY=
# MAX_BYTES_PER_ACCOUNT_PER_DAY=
# MAX_DERIVED_PER_ACCOUNT_PER_DAY=
# MAX_PLATFORM_SESSIONS_PER_DAY=
# MAX_PLATFORM_CHUNKS_PER_DAY=
# MAX_PLATFORM_BYTES_PER_DAY=
# MAX_PLATFORM_DERIVED_PER_DAY=
# MAX_RETENTION_DAYS=
# MAX_HEATMAP_RETENTION_DAYS=
# MAX_LINKS_PER_SITE=
# MAX_LINK_BYTES_PER_DAY=
# MAX_VERIFY_PER_ACCOUNT_PER_HOUR=
# CAPTURE_CONSOLE_ERRORS_DEFAULT=
# MAX_UPGRADED_SESSIONS_PER_SITE_PER_DAY=
# MAX_SEGMENTS_PER_SITE=
# MAX_EVENT_DEFINITIONS_PER_SITE=
# MAX_STARRED_SESSIONS_PER_SITE=
# MAX_STARRED_RETENTION_DAYS=
# MAX_NOTES_PER_SESSION=
# MAX_NOTES_PER_SITE=
# MAX_LABELS_PER_SITE=
# MAX_SURVEYS_PER_SITE=
# MAX_ACTIVE_SURVEYS_PER_SITE=
# MAX_QUESTIONS_PER_SURVEY=
# MAX_ANSWER_CHARS=
# MAX_RESPONSES_PER_SITE_PER_DAY=
# MAX_RESPONSES_PER_NETWORK_PER_SITE_PER_DAY=
# MAX_TEST_RESPONSES_PER_SITE_PER_DAY=
# MAX_IMPRESSIONS_PER_NETWORK_PER_SITE_PER_DAY=
# MAX_WEBHOOKS_PER_ACCOUNT=
# MAX_WEBHOOK_DELIVERIES_PER_ACCOUNT_PER_DAY=
# MAX_WEBHOOK_TESTS_PER_DAY=
# MAX_EXPORT_ROWS=
# MAX_EXPORT_BYTES_PER_DAY=
